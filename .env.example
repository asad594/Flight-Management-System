# ==============================================================================
# SkyBound Flight Management System - Environment Variables Template
# ==============================================================================
# Copy this file to '.env' and adjust the configuration values to match your local setup.

# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-skybound-dev-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Defaults to local SQLite db.sqlite3)
DATABASE_ENGINE=sqlite3
DATABASE_NAME=db.sqlite3

# Custom Pure Python Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Application Defaults
DEFAULT_CURRENCY=USD
DEFAULT_SYSTEM_NAME=SkyBound
DEFAULT_TAX_RATE=0.05
